[
  {
    "text": "天气预报最低零下三摄氏度",
    "start": 0.526,
    "end": 3.04
  },
  {
    "text": "这个数写作负三",
    "start": 3.04,
    "end": 4.793
  },
  {
    "text": "也读作负三摄氏度",
    "start": 4.793,
    "end": 6.393
  },
  {
    "text": "零摄氏度是没有温度吗",
    "start": 6.698,
    "end": 8.45
  },
  {
    "text": "小学学过负数",
    "start": 9.186,
    "end": 10.482
  },
  {
    "text": "初中要理解",
    "start": 10.786,
    "end": 11.929
  },
  {
    "text": "同一组量",
    "start": 12.005,
    "end": 13.072
  },
  {
    "text": "怎么用一套符号表示",
    "start": 13.072,
    "end": 14.596
  },
  {
    "text": "关键在「规定」",
    "start": 15.129,
    "end": 16.272
  },
  {
    "text": "收入二百",
    "start": 16.577,
    "end": 17.644
  },
  {
    "text": "支出一百五十",
    "start": 17.796,
    "end": 19.015
  },
  {
    "text": "规定收入为正",
    "start": 19.548,
    "end": 20.615
  },
  {
    "text": "记正二百、负一百五十",
    "start": 20.92,
    "end": 23.434
  },
  {
    "text": "规定支出为正",
    "start": 23.434,
    "end": 24.577
  },
  {
    "text": "记负二百、正一百五十",
    "start": 24.882,
    "end": 27.396
  },
  {
    "text": "两种都行",
    "start": 27.396,
    "end": 28.082
  },
  {
    "text": "但同一题选一种",
    "start": 28.082,
    "end": 29.453
  },
  {
    "text": "正号、负号",
    "start": 29.453,
    "end": 31.053
  },
  {
    "text": "不是加减法",
    "start": 31.053,
    "end": 32.044
  },
  {
    "text": "那零呢",
    "start": 32.934,
    "end": 33.544
  },
  {
    "text": "零个苹果",
    "start": 33.848,
    "end": 34.534
  },
  {
    "text": "是一个也没有",
    "start": 34.763,
    "end": 35.601
  },
  {
    "text": "零摄氏度不是没有温度",
    "start": 35.982,
    "end": 37.963
  },
  {
    "text": "它是温度计上的确定刻度",
    "start": 37.963,
    "end": 40.02
  },
  {
    "text": "零米海拔也不是没有高度",
    "start": 40.02,
    "end": 42.382
  },
  {
    "text": "它是海平面",
    "start": 42.382,
    "end": 43.448
  },
  {
    "text": "零既不是正数",
    "start": 43.448,
    "end": 45.048
  },
  {
    "text": "也不是负数",
    "start": 45.048,
    "end": 46.115
  },
  {
    "text": "是分界",
    "start": 46.115,
    "end": 46.877
  },
  {
    "text": "用数轴把大小看得见",
    "start": 47.854,
    "end": 49.835
  },
  {
    "text": "一条直线",
    "start": 50.368,
    "end": 51.207
  },
  {
    "text": "规定原点",
    "start": 51.359,
    "end": 52.273
  },
  {
    "text": "正方向",
    "start": 52.426,
    "end": 53.035
  },
  {
    "text": "单位长度",
    "start": 53.264,
    "end": 54.026
  },
  {
    "text": "正方向画箭头",
    "start": 54.635,
    "end": 55.854
  },
  {
    "text": "通常向右",
    "start": 56.007,
    "end": 56.768
  },
  {
    "text": "每一格一样长",
    "start": 57.226,
    "end": 58.521
  },
  {
    "text": "正三在右边三个单位",
    "start": 58.978,
    "end": 61.378
  },
  {
    "text": "负三在左边三个单位",
    "start": 61.378,
    "end": 63.778
  },
  {
    "text": "右边总比左边大",
    "start": 63.778,
    "end": 65.645
  },
  {
    "text": "负三和负一，谁大",
    "start": 66.178,
    "end": 68.045
  },
  {
    "text": "负三在负一左边",
    "start": 70.158,
    "end": 71.987
  },
  {
    "text": "所以负三小于负一",
    "start": 72.139,
    "end": 73.663
  }
